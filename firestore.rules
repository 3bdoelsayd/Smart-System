rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStudent() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*\\.college@smart\\.com');
    }

    function isTestStudent() {
      return isAuthenticated() &&
             request.auth.uid != null &&
             request.auth.uid.matches('^STD_1000[0-9]$'); // STD_10001 to STD_10013
    }

    function canAccessCollege(collegeId) {
      // Test students can only access 'testers' college
      return !isTestStudent() || collegeId == 'testers';
    }

    function isDoctor(collegeId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/colleges/$(collegeId)/doctors/$(request.auth.uid));
    }

    function isManager(collegeId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/colleges/$(collegeId)/managers/$(request.auth.uid));
    }

    function isTA(collegeId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/colleges/$(collegeId)/tas/$(request.auth.uid));
    }

    function isStaff(collegeId) {
      return isDoctor(collegeId) || isManager(collegeId) || isTA(collegeId);
    }

    // College context security rules
    match /colleges/{collegeId} {

      // College document - read only for authorized users
      allow read: if isAuthenticated() && canAccessCollege(collegeId);
      allow write: if false; // Only via Admin SDK

      // Exams Collection - Staff only can modify
      match /exams/{examId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow create, update, delete: if isStaff(collegeId) && canAccessCollege(collegeId);

        match /questions/{questionId} {
          allow read: if isAuthenticated() && canAccessCollege(collegeId);
          allow create, update, delete: if isStaff(collegeId) && canAccessCollege(collegeId);
        }

        match /submissions/{submissionId} {
          allow read: if isAuthenticated() && canAccessCollege(collegeId) && (
            resource.data.studentUid == request.auth.uid ||
            isStaff(collegeId)
          );
          allow create: if isStudent() && canAccessCollege(collegeId) &&
                        request.resource.data.studentUid == request.auth.uid;
          allow update, delete: if isStaff(collegeId) && canAccessCollege(collegeId);
        }
      }

      // Notifications Collection - Users can only delete their own
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId) &&
                    resource.data.recipientUid == request.auth.uid;
        allow create: if isStaff(collegeId) && canAccessCollege(collegeId);
        allow update: if isAuthenticated() && canAccessCollege(collegeId) &&
                      resource.data.recipientUid == request.auth.uid;
        allow delete: if isAuthenticated() && canAccessCollege(collegeId) &&
                      resource.data.recipientUid == request.auth.uid;
      }

      // Private Chats Collection - Participants only
      match /private_chats/{chatId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId) &&
                    resource.data.participants.hasAny([request.auth.uid]);
        allow create: if isAuthenticated() && canAccessCollege(collegeId) &&
                      request.resource.data.participants.hasAny([request.auth.uid]);
        allow update, delete: if isAuthenticated() && canAccessCollege(collegeId) &&
                              resource.data.participants.hasAny([request.auth.uid]);

        match /messages/{messageId} {
          allow read: if isAuthenticated() && canAccessCollege(collegeId) &&
                      get(/databases/$(database)/documents/colleges/$(collegeId)/private_chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
          allow create: if isAuthenticated() && canAccessCollege(collegeId) &&
                        request.resource.data.senderUid == request.auth.uid;
          allow update, delete: if isAuthenticated() && canAccessCollege(collegeId) &&
                                resource.data.senderUid == request.auth.uid;
        }
      }

      // Students Collections
      match /students/{studentId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow write: if (isStaff(collegeId) || request.auth.uid == studentId) &&
                     canAccessCollege(collegeId);
      }

      // Levels and their subcollections
      match /levels/{levelId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow write: if isStaff(collegeId) && canAccessCollege(collegeId);

        // Students in each level
        match /students/{studentId} {
          allow read: if isAuthenticated() && canAccessCollege(collegeId);
          allow write: if (isStaff(collegeId) || request.auth.uid == studentId) &&
                       canAccessCollege(collegeId);
        }

        // Courses in each level
        match /courses/{courseId} {
          allow read: if isAuthenticated() && canAccessCollege(collegeId);
          allow write: if isStaff(collegeId) && canAccessCollege(collegeId);

          // Lectures and Sections
          match /lectures/{lectureId} {
            allow read: if isAuthenticated() && canAccessCollege(collegeId);
            allow write: if isStaff(collegeId) && canAccessCollege(collegeId);
          }

          match /sections/{sectionId} {
            allow read: if isAuthenticated() && canAccessCollege(collegeId);
            allow write: if isStaff(collegeId) && canAccessCollege(collegeId);
          }

          // Attendance records
          match /attendance/{attendanceId} {
            allow read: if isAuthenticated() && canAccessCollege(collegeId);
            allow write: if isStaff(collegeId) && canAccessCollege(collegeId);
          }
        }
      }

      // Staff Collections - Read by all, Write by managers only
      match /doctors/{doctorId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow write: if isManager(collegeId) && canAccessCollege(collegeId);
      }

      match /tas/{taId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow write: if isManager(collegeId) && canAccessCollege(collegeId);
      }

      match /managers/{managerId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow write: if false; // Only super admin via Admin SDK
      }

      match /super_admins/{adminId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow write: if false; // Only via Admin SDK or system
      }

      // Researches - Students can create, Staff can review
      match /researches/{researchId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow create: if isStudent() && canAccessCollege(collegeId);
        allow update: if canAccessCollege(collegeId) &&
                      (isStaff(collegeId) || (isStudent() && resource.data.studentUid == request.auth.uid));
        allow delete: if isStaff(collegeId) && canAccessCollege(collegeId);
      }

      // Schedule Entries - Read by all, Write by staff
      match /schedule_entries/{entryId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow write: if isStaff(collegeId) && canAccessCollege(collegeId);
      }

      // Discussion Forum - All authenticated can read/write
      match /discussion_forum/{postId} {
        allow read: if isAuthenticated() && canAccessCollege(collegeId);
        allow create: if isAuthenticated() && canAccessCollege(collegeId);
        allow update, delete: if isAuthenticated() && canAccessCollege(collegeId) &&
                              resource.data.authorUid == request.auth.uid;
      }
    }

    // Root-level collections (apps_info, etc.) - Read only
    match /apps_info/{doc} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }
  }
}
